#!/usr/bin/env bash

set -euo pipefail

SCRIPT_NAME=$(basename "$0")

help() {
  cat << EOF
usage: $SCRIPT_NAME [OPTION] [TERM]...
Query MyAnonamouse for torrents
Example: $SCRIPT_NAME -a "The Fisherman"

Options:
  -a,--audiobooks
        search audiobooks (default)
  -e,--ebooks
        search e-books
  -A,--all-categories
        search all main categories
  -f,--freeleech
        show only freeleech torrents
  -x,--exclude-downloaded
        exclude torrents already downloaded in the current directory
  -h,--help
        print this message
EOF
  exit 0
}

CATEGORY=13
SEARCH_TYPE="all"
EXCLUDE_DOWNLOADED=false
POSITIONAL=()

# Parse CLI options
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      help
      ;;
    -a|--audiobooks)
      CATEGORY=13
      shift
      ;;
    -e|--ebooks)
      CATEGORY=14
      shift
      ;;
    -A|--all-categories)
      CATEGORY=0
      shift
      ;;
    -f|--freeleech)
      SEARCH_TYPE="fl"
      shift
      ;;
    -x|--exclude-downloaded)
      EXCLUDE_DOWNLOADED=true
      shift
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

# Restore search terms into $@
set -- "${POSITIONAL[@]}"

# Check dependencies
for cmd in curl jq fzf column; do
  command -v "$cmd" >/dev/null || {
    echo "Missing dependency: $cmd" >&2
    exit 1
  }
done

# Build API URL and retrieve authentication cookie
base_url="https://www.myanonamouse.net"
url="${base_url}/tor/js/loadSearchJSONbasic.php"

# Set MAM_ID in your environment, or use rbw as a fallback
if [ -z "${MAM_ID:-}" ]; then
  if ! command -v rbw >/dev/null; then
    echo "Error: Set MAM_ID or install and configure rbw to retrieve the API cookie" >&2
    exit 1
  fi

  if ! MAM_ID=$(rbw get myanonamouse.net --field "mam_id (API)") || [ -z "$MAM_ID" ]; then
    echo "Error: Could not retrieve the API cookie using rbw; set MAM_ID or check your rbw entry" >&2
    exit 1
  fi
fi

# Build JSON search request
payload=$(jq -n \
  --arg text "$*" \
  --arg search_type "$SEARCH_TYPE" \
  --argjson category "$CATEGORY" \
  '{
    tor: {
      text: $text,
      srchIn: ["title", "author", "narrator"],
      searchType: $search_type,
      searchIn: "torrents",
      main_cat: (if $category == 0 then [13,14,15,16] else [$category] end),
      cat: ["0"],
      sortType: "default",
      startNumber: 0
    },
    perpage: 1000
  }')

# Fetch JSON search results
req=$(mktemp)
trap 'rm -f "$req"' EXIT

# Back off on rate limits and transient failures, respecting Retry-After
curl_retry=(--retry 5 --retry-max-time 300)

status=$(
  curl \
    "${curl_retry[@]}" \
    --connect-timeout 5 \
    -sS \
    -X POST \
    -w "%{http_code}" \
    -o "$req" \
    -b "mam_id=$MAM_ID" \
    -H "Content-Type: application/json" \
    -d "$payload" \
    "$url"
)

if [ "$status" -ne 200 ]; then
  echo "Error: HTTP $status" >&2
  exit 1
fi

# Collect IDs of torrents already downloaded in the current directory
downloaded_ids=()

if "$EXCLUDE_DOWNLOADED"; then
  for file in ./'['*']_'*.torrent; do
    [[ -f "$file" ]] || continue

    id=${file#./[}
    id=${id%%]*}

    [[ "$id" =~ ^[0-9]+$ ]] && downloaded_ids+=("$id")
  done
fi

# Convert downloaded IDs to JSON
downloaded_json=$(printf '%s\n' "${downloaded_ids[@]}" |
  jq -Rsc 'split("\n") | map(select(length > 0))')

# Parse JSON and collate torrent metadata, optionally excluding downloaded IDs
torrents_table=$(jq -r \
  --argjson exclude "$EXCLUDE_DOWNLOADED" \
  --argjson downloaded "$downloaded_json" '
  ($downloaded | INDEX(.)) as $existing
  |
  (["ID", "FL", "SEEDERS", "SIZE", "CATEGORY", "NAME"] | join("\u001F")),
  (
    .data[]
    | select(
        ($exclude | not) or
        (($existing[.id | tostring] // null) == null)
      )
    | [
        .id,
        (if .free == 1 or .free == true then "🪙" else "--" end),
        .seeders,
        .size,
        (.catname | split(" - ") | last),
        (.title | tostring | gsub("[\t\r\n]"; " "))
      ]
    | join("\u001F")
  )
' < "$req" | column -s $'\x1F' -t)

# Exit if no torrents returned (just header)
if [ "$(printf '%s\n' "$torrents_table" | wc -l)" -lt 2 ]; then
  echo "No torrents found"
  exit 0
fi

# Launch fzf to allow the user to select torrents
selected=$(printf '%s\n' "$torrents_table" |
  fzf --multi \
      --header-lines=1 \
      --with-nth=2.. \
      --no-hscroll \
      --prompt="Torrents > ") || exit 0

# Exit silently if nothing was selected
[ -z "$selected" ] && exit 0

# Download selected torrents
failed_file="failed-torrents.txt"
failed_count=0

while read -r tid; do
  download_url="$base_url/tor/download.php?tid=$tid"

  if download_info=$(curl -fL \
    "${curl_retry[@]}" \
    --progress-bar \
    -w '%{filename_effective} (%{size_download} bytes)' \
    -b "mam_id=$MAM_ID" \
    -OJ \
    "$download_url"); then
    printf '\nDownloaded: %s\n\n' "$download_info"
  else
    printf '%s\n' "$download_url" >> "$failed_file"
    failed_count=$((failed_count + 1))
    printf '\nFailed to download torrent %s; saved to %s\n' "$tid" "$failed_file" >&2
  fi
done < <(printf '%s\n' "$selected" | awk '{print $1}')

if [ "$failed_count" -gt 0 ]; then
  printf '%s download(s) failed. URLs appended to %s\n' "$failed_count" "$failed_file" >&2
  exit 1
fi
